# pg_promise_guard extension
comment = 'Find the guarantees your schema claims to give and silently stopped giving'
default_version = '0.2.0'
relocatable = false
schema = promise_guard
# Since 0.2.0, watch() records each scan as a living assertion, so the result
# carries the date it was taken. The scan itself still keeps no state: reading
# the catalog is this extension's job, remembering that you read it is not.
requires = 'pg_living_assertions'
